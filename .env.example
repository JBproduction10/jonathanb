# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string   # generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Admin login (used by the one-time seed script to create the admin user)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now

# Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
